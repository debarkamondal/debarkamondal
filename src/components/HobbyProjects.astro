---
const hobbyProjects = [
  {
    name: "dezmerce",
    description:
      "Cafe management platform for real-time table, order, and payment management. Built with a Next.js / TypeScript frontend and an AWS serverless backend using Hono.js.",
    tech: ["Next.js", "TypeScript", "Hono.js", "AWS Lambda"],
    repoUrl: "https://github.com/debarkamondal/dezmerce",
  },
  {
    name: "adda-cafe",
    description:
      "Full-stack ordering and administration platform built with a reactive SvelteKit client and a high-performance Go backend service.",
    tech: ["SvelteKit", "Go", "Tailwind CSS"],
    repoUrl: "https://github.com/debarkamondal/adda-cafe",
  },
  {
    name: "twitter-clone",
    description:
      "Social platform architecture exploration featuring Next.js 13, GraphQL API design, Prisma ORM, and PostgreSQL data persistence.",
    tech: ["Next.js 13", "GraphQL", "Prisma", "PostgreSQL"],
    repoUrl: "https://github.com/debarkamondal/twitter-clone-frontend",
  },
];
---

<section
  id="hobby-projects"
  class="max-w-[1440px] mx-auto px-4 md:px-8 py-16 md:py-24 border-t border-border"
>
  <div class="mb-12">
    <div class="flex items-center gap-3">
      <h2 class="text-3xl font-mono font-bold tracking-tight">
        Learning & Hobby Projects
      </h2>
      <span class="text-xs font-mono px-2 py-0.5 border border-border text-text/60">Archive</span>
    </div>
    <p class="text-text/70 mt-2 text-sm max-w-xl">
      Explorations, experiments, and earlier full-stack applications building product features across different language ecosystems.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      hobbyProjects.map((project) => (
        <div class="border border-border p-6 bg-card/60 hover:border-accent hover:bg-card transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h4 class="font-mono font-bold text-lg group-hover:text-accent transition-colors truncate">
                {project.name}
              </h4>
              <div class="flex items-center gap-2">
                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-mono px-2 py-0.5 border border-border hover:border-accent hover:text-accent transition-colors"
                    title="Live Demo"
                  >
                    Demo ↗
                  </a>
                )}
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-text/40 hover:text-accent p-1 transition-colors"
                  aria-label={`GitHub repo for ${project.name}`}
                >
                  <svg
                    class="w-4 h-4"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"
                    ></path>
                  </svg>
                </a>
              </div>
            </div>
            <p class="text-sm text-text/70 mb-4 min-h-[3.5rem]">{project.description}</p>
          </div>
          <div class="flex flex-wrap gap-2 pt-2 border-t border-border/50">
            {project.tech.map((t) => (
              <span class="text-xs font-mono px-2 py-0.5 bg-text/5 text-text/80">{t}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
