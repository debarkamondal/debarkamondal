---
const hobbyProjects = [
  {
    name: "dezmerce",
    description:
      "Cafe management platform for real-time table, order, and payment management. Built with a Next.js / TypeScript frontend and an AWS serverless backend using Hono.js.",
    tech: ["Next.js", "TypeScript", "Hono.js", "AWS Lambda"],
    repoUrl: "https://github.com/debarkamondal/dezmerce",
    version: "v0.1.0",
  },
  {
    name: "adda-cafe",
    description:
      "Full-stack ordering and administration platform built with a reactive SvelteKit client and a high-performance Go backend service.",
    tech: ["SvelteKit", "Go", "Tailwind CSS"],
    repoUrl: "https://github.com/debarkamondal/adda-cafe",
    version: "v0.1.0",
  },
  {
    name: "twitter-clone",
    description:
      "Social platform architecture exploration featuring Next.js 13, GraphQL API design, Prisma ORM, and PostgreSQL data persistence.",
    tech: ["Next.js 13", "GraphQL", "Prisma", "PostgreSQL"],
    repoUrl: "https://github.com/debarkamondal/twitter-clone-frontend",
    version: "v0.1.0",
  },
];
---

<section
  id="hobby-projects"
  class="max-w-[1440px] mx-auto px-4 md:px-8 py-16 md:py-24 border-t border-border"
>
  <div class="mb-12">
    <div>
      <span class="text-xs font-mono text-accent/80 tracking-widest block mb-2 font-semibold">
        03 // LEARNING & HOBBY PROJECTS
      </span>
      <h2 class="text-3xl font-mono font-bold tracking-tight">
        Learning & Hobby Projects
      </h2>
    </div>
    <p class="text-text/70 mt-2 text-sm max-w-xl">
      Explorations, experiments, and earlier full-stack applications building product features across different language ecosystems. Click any card to view release info and recent commits.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      hobbyProjects.map((project) => (
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="repo-modal-trigger border border-border/80 p-6 bg-card hover:bg-white dark:hover:bg-[#18181b] hover:border-text/70 dark:hover:border-white/40 hover:-translate-y-1 hover:shadow-md transition-all duration-300 group flex flex-col justify-between block cursor-pointer"
          data-repo-name={project.name}
          data-repo-url={project.repoUrl}
          data-repo-desc={project.description}
          data-repo-tech={JSON.stringify(project.tech)}
          data-repo-version={project.version}
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <h4 class="font-mono font-bold text-base text-text group-hover:text-text transition-colors truncate">
                {project.name}
              </h4>
              <svg
                class="w-4 h-4 text-text/30 group-hover:text-text group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all flex-shrink-0 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path>
              </svg>
            </div>
            <p class="text-sm text-text/70 group-hover:text-text/90 transition-colors mb-4 min-h-[3.5rem] leading-relaxed">
              {project.description}
            </p>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-border/60">
            {project.tech.map((t) => (
              <span class="text-xs font-mono text-text/60 group-hover:text-text/80 bg-text/5 group-hover:bg-text/10 px-2 py-0.5 transition-colors">
                {t}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>

<script>
  function setupHobbyRepoTriggers() {
    const cards = document.querySelectorAll("#hobby-projects .repo-modal-trigger");
    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        const mouseEvent = e as MouseEvent;
        if (
          mouseEvent.ctrlKey ||
          mouseEvent.metaKey ||
          mouseEvent.shiftKey ||
          mouseEvent.button !== 0
        ) {
          return;
        }

        e.preventDefault();
        const el = card as HTMLElement;
        const name = el.dataset.repoName || "";
        const url = el.dataset.repoUrl || el.getAttribute("href") || "";
        const description = el.dataset.repoDesc || "";
        const version = el.dataset.repoVersion || "v0.1.0-dev";
        const tech = el.dataset.repoTech ? JSON.parse(el.dataset.repoTech) : [];

        if (typeof (window as any).openRepoModal === "function") {
          (window as any).openRepoModal({
            name,
            url,
            description,
            tech,
            defaultVersion: version,
          });
        }
      });
    });
  }

  setupHobbyRepoTriggers();
  document.addEventListener("astro:page-load", setupHobbyRepoTriggers);
</script>
