---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-bg/85 backdrop-blur-md border-b border-border/80"
>
  <div
    class="max-w-[1440px] mx-auto px-4 md:px-8 h-16 flex items-center justify-between"
  >
    <a
      href="#"
      class="font-mono font-bold text-lg tracking-tight relative z-50 flex items-center gap-0.5 group"
    >
      <span>dkmondal.in</span>
      <span class="text-accent font-mono animate-pulse">_</span>
    </a>

    <div class="flex items-center gap-2 md:gap-4">
      <nav
        id="nav-menu"
        class="fixed inset-0 bg-bg/98 backdrop-blur-lg flex-col items-center justify-center gap-8 text-lg font-medium hidden md:static md:flex md:flex-row md:bg-transparent md:h-auto md:gap-6 md:text-sm z-40"
      >
        <a
          href="#ecosystem"
          class="nav-link text-text/80 hover:text-text transition-colors"
          >Ecosystem</a
        >
        <a
          href="#open-source"
          class="nav-link text-text/80 hover:text-text transition-colors"
          >Open Source</a
        >
        <a
          href="#hobby-projects"
          class="nav-link text-text/80 hover:text-text transition-colors"
          >Hobby Projects</a
        >
        <a
          href="#contact"
          class="nav-link text-text/80 hover:text-text transition-colors"
          >Contact</a
        >
        <span
          class="text-accent/40 font-mono text-xs cursor-not-allowed select-none"
          title="Coming soon"
          >[Blog]</span
        >

        <a
          href="mailto:debarkamondal@gmail.com"
          class="nav-link flex items-center gap-2 border border-text/80 px-4 py-1.5 font-mono text-xs hover:bg-text hover:text-bg transition-all duration-300 md:ml-2 shadow-xs"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-mail"
            ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
              d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
          >
          Hire Me
        </a>
      </nav>

      <div class="hidden md:block w-px h-4 bg-border mx-2"></div>

      <div class="relative z-50 flex items-center gap-1">
        <a
          href="https://github.com/debarkamondal"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors text-text inline-flex items-center justify-center"
          aria-label="GitHub Profile (@debarkamondal)"
          title="GitHub (@debarkamondal)"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"
            ></path>
          </svg>
        </a>

        <ThemeToggle />

        <button
          id="mobile-menu-btn"
          class="md:hidden ml-1 p-2 text-text hover:bg-black/5 dark:hover:bg-white/10 rounded-full transition-colors"
          aria-label="Toggle menu"
        >
          <svg
            id="menu-icon"
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="close-icon"
            class="w-5 h-5 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const navMenu = document.getElementById("nav-menu");
  const navLinks = document.querySelectorAll(".nav-link");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  const toggleMenu = () => {
    navMenu?.classList.toggle("hidden");
    navMenu?.classList.toggle("flex");
    document.body.classList.toggle("overflow-hidden");
    menuIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  };

  mobileMenuBtn?.addEventListener("click", toggleMenu);

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (window.innerWidth < 768) {
        toggleMenu();
      }
    });
  });
</script>
