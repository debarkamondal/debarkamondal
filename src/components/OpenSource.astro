---

<section
  id="open-source"
  class="max-w-[1440px] mx-auto px-4 md:px-8 py-16 md:py-24 border-t border-border"
>
  <div class="mb-12">
    <span class="text-xs font-mono text-accent/80 tracking-widest block mb-2 font-semibold">
      02 // OPEN SOURCE & UPSTREAM CONTRIBUTIONS
    </span>
    <h2 class="text-3xl font-mono font-bold tracking-tight">Pull Requests & Upstream Work</h2>
    <p class="text-text/70 mt-2 text-sm max-w-xl">
      Upstream contributions to core infrastructure, audio codecs, and distributed systems. Hover or tap any PR to inspect its individual commits, or click to view the pull request on GitHub.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
    {
      pullRequests.map((pr) => (
        <div
          class="pr-card border border-border/80 p-6 bg-card hover:bg-white dark:hover:bg-[#18181b] hover:border-text/70 dark:hover:border-white/40 hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden flex flex-col justify-between group text-left cursor-pointer select-none md:select-auto"
          data-url={pr.url}
          data-expanded="false"
        >
          <div class="absolute top-0 right-0 p-6 opacity-[0.03] dark:opacity-[0.05] pointer-events-none group-hover:opacity-[0.08] group-hover:scale-105 transition-all duration-500">
            <svg
              class="w-28 h-28"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"
              ></path>
            </svg>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-mono text-accent group-hover:text-text font-semibold tracking-wide transition-colors truncate">
                {pr.repo}
              </span>
              <span class="text-xs font-mono text-text/60 group-hover:text-text tracking-wide transition-colors flex-shrink-0">
                // PR #{pr.prNumber} · {pr.status.toUpperCase()}
              </span>
            </div>

            <h3 class="font-mono text-lg font-bold tracking-tight text-text group-hover:text-text transition-colors mb-2 leading-snug">
              {pr.title}
            </h3>

            <p class="text-text/75 group-hover:text-text/95 transition-colors mb-4 text-xs leading-relaxed">
              {pr.description}
            </p>
          </div>

          <div>
            <div class="flex flex-wrap gap-1.5 mb-3">
              {pr.tech.map((t) => (
                <span class="text-xs font-mono text-text/60 group-hover:text-text/80 bg-text/5 group-hover:bg-text/10 px-2 py-0.5 transition-colors">
                  {t}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between text-xs font-mono pt-3 border-t border-border/60">
              <a
                href={pr.url}
                target="_blank"
                rel="noopener noreferrer"
                class="pr-direct-link inline-flex items-center gap-1.5 font-semibold text-text/80 hover:text-text transition-colors group/link py-1"
              >
                <span>View PR #{pr.prNumber}</span>
                <span class="text-[11px] group-hover/link:translate-x-0.5 transition-transform">↗</span>
              </a>

              <button
                type="button"
                class="commits-toggle inline-flex items-center gap-2 border border-border/80 hover:border-text/80 bg-card hover:bg-white dark:hover:bg-[#202024] px-2.5 py-1 text-text/80 hover:text-text font-semibold transition-all duration-200 focus:outline-none cursor-pointer"
                aria-label={`Toggle commits for PR #${pr.prNumber}`}
                aria-expanded="false"
              >
                <span class="text-xs">{pr.commits.length} {pr.commits.length === 1 ? 'commit' : 'commits'}</span>
                <svg
                  class="w-3.5 h-3.5 text-accent group-hover:text-text group-hover:rotate-180 group-data-[expanded=true]:rotate-180 transition-transform duration-300 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M19 9l-7 7-7-7"
                  ></path>
                </svg>
              </button>
            </div>

            <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] group-data-[expanded=true]:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-out overflow-hidden">
              <div class="overflow-hidden">
                <div class="pt-3 mt-3 border-t border-dashed border-border/70">
                  <div class="text-[11px] font-mono text-accent tracking-wider font-semibold mb-2">
                    // COMMITS IN PR ({pr.commits.length})
                  </div>
                  <div class="space-y-1.5 font-mono text-xs">
                    {pr.commits.map((c) => (
                      <div class="flex items-start gap-2 py-1 px-1.5 -mx-1.5 bg-text/[0.03] group-hover:bg-text/[0.06] transition-colors">
                        <span class="text-accent font-semibold flex-shrink-0">
                          {c.sha}
                        </span>
                        <span class="text-text/75 group-hover:text-text/95 truncate" title={c.msg}>
                          {c.msg}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  function initPRCards() {
    const cards = document.querySelectorAll<HTMLElement>('.pr-card');
    const isTouchDevice = !window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    cards.forEach((card) => {
      const toggleBtn = card.querySelector<HTMLButtonElement>('.commits-toggle');

      const toggleExpand = (e?: Event) => {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        const isCurrentlyExpanded = card.getAttribute('data-expanded') === 'true';
        const nextState = !isCurrentlyExpanded;
        card.setAttribute('data-expanded', nextState ? 'true' : 'false');
        if (toggleBtn) {
          toggleBtn.setAttribute('aria-expanded', nextState ? 'true' : 'false');
        }
      };

      // Toggle button explicitly expands/collapses commits on tap/click
      toggleBtn?.addEventListener('click', toggleExpand);

      // Card click handling
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        // If clicking a direct PR link to GitHub, allow default navigation
        if (target.closest('.pr-direct-link')) {
          return;
        }

        // If clicking toggle button, already handled
        if (target.closest('.commits-toggle')) {
          return;
        }

        // On mobile touch devices: tap anywhere on card to toggle commits
        if (isTouchDevice) {
          toggleExpand();
        } else {
          // On desktop mouse: clicking anywhere on card opens PR in new tab
          const url = card.dataset.url;
          if (url) {
            window.open(url, '_blank', 'noopener,noreferrer');
          }
        }
      });
    });
  }

  initPRCards();
  document.addEventListener('astro:page-load', initPRCards);
</script>
