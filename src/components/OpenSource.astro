---
const contributions = [
  {
    title: "rmqtt / rmqtt",
    role: "Contributor (PR #372)",
    description:
      "A scalable, distributed MQTT message broker written in Rust for IoT in the 5G era. Implemented core offline message event support for the WebHook plugin, enabling real-time lifecycle event handling and message delivery across distributed clusters.",
    tech: ["Rust", "MQTT", "Distributed Systems", "IoT"],
    repoUrl: "https://github.com/rmqtt/rmqtt",
    prUrl: "https://github.com/rmqtt/rmqtt/pull/372",
  },
  {
    title: "opus-pure",
    role: "Creator",
    description:
      "A pure-Rust implementation of the Opus audio codec (RFC 6716) with Ogg encapsulation (RFC 7845). Encoder and decoder supporting SILK, CELT, and hybrid modes with zero C code, zero FFI, and zero external dependencies.",
    tech: ["Rust", "Audio Codec", "RFC 6716", "docs.rs"],
    repoUrl: "https://github.com/debarkamondal/opus-pure",
    docsUrl: "https://docs.rs/opus-pure",
  },
];
---

<section
  id="open-source"
  class="max-w-[1440px] mx-auto px-4 md:px-8 py-16 md:py-24 border-t border-border"
>
  <div class="mb-12">
    <h2 class="text-3xl font-mono font-bold tracking-tight">Open Source & Systems</h2>
    <p class="text-text/70 mt-2 text-sm max-w-xl">
      Upstream contributions to core infrastructure projects and standalone systems crates built in Rust.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {
      contributions.map((item) => (
        <div class="border border-border p-6 md:p-8 bg-card hover:border-accent transition-colors relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 right-0 p-6 opacity-5 pointer-events-none">
            <svg
              class="w-32 h-32"
              fill="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"
              ></path>
            </svg>
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between gap-4 mb-3">
              <h3 class="font-mono text-2xl font-bold">{item.title}</h3>
              <span class="text-xs font-mono px-2.5 py-1 border border-accent/40 text-accent">
                {item.role}
              </span>
            </div>
            <p class="text-text/80 mb-6 text-sm leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="relative z-10 pt-4 border-t border-border/50">
            <div class="flex flex-wrap gap-2 mb-6">
              {item.tech.map((t) => (
                <span class="text-xs font-mono px-2 py-0.5 bg-text/5 text-text/80">
                  {t}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-4 text-sm font-mono">
              <a
                href={item.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 hover:text-accent transition-colors"
              >
                <span>Repository</span>
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path>
                </svg>
              </a>

              {item.prUrl && (
                <a
                  href={item.prUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-accent hover:underline transition-colors"
                >
                  <span>Pull Request #372</span>
                  <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path>
                  </svg>
                </a>
              )}

              {item.docsUrl && (
                <a
                  href={item.docsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-accent hover:underline transition-colors"
                >
                  <span>docs.rs Documentation</span>
                  <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
