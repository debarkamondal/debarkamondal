---
const coreRepos = [
  {
    name: "deezchatz-mobile",
    description:
      "Cross-platform end-to-end encrypted messaging application built with React Native and Expo.",
    tech: ["React Native", "Expo", "TypeScript", "E2EE"],
    url: "https://github.com/deez-in/deezchatz-mobile",
    version: "v0.1.0",
    colSpan: "lg:col-span-2",
  },
  {
    name: "deezchatz-api",
    description:
      "High-throughput backend service handling cryptographic key exchange, sessions, and real-time message routing.",
    tech: ["Rust", "Axum", "Redis", "Distributed"],
    url: "https://github.com/deez-in/deezchatz-api",
    version: "v0.1.0",
    colSpan: "lg:col-span-2",
  },
  {
    name: "libsignal-dezire",
    description:
      "Pure-Rust Signal Protocol implementation (X3DH, Double Ratchet) engineered for high performance and cross-platform FFI.",
    tech: ["Rust", "Signal Protocol", "Cryptography", "FFI"],
    url: "https://github.com/deez-in/libsignal-dezire",
    version: "v0.1.0",
    colSpan: "lg:col-span-1",
  },
  {
    name: "deezchatz-sdk-rust",
    description:
      "Asynchronous client SDK encapsulating Signal Protocol ratchets, stateless VXEdDSA REST authentication, event-driven MQTT networking, and pluggable storage traits.",
    tech: ["Rust", "Tokio", "Signal Protocol", "MQTT"],
    url: "https://github.com/deez-in/deezchatz-sdk-rust",
    version: "v0.1.0",
    colSpan: "lg:col-span-1",
  },
  {
    name: "deezchatz-cli",
    description:
      "Terminal-native client featuring an Elm-architecture Ratatui TUI, headless scriptable subcommands, multi-database SQLCipher storage, and OS keyring integration.",
    tech: ["Rust", "Ratatui", "SQLCipher", "E2EE"],
    url: "https://github.com/deez-in/deezchatz-cli",
    version: "v0.1.0",
    colSpan: "lg:col-span-1",
  },
  {
    name: "deezchatz-infra",
    description:
      "Ansible playbooks and infrastructure automation for provisioning and maintaining the DeezChatz cloud infrastructure.",
    tech: ["Ansible", "IaC", "Linux", "DevOps"],
    url: "https://github.com/deez-in/deezchatz-infra",
    version: "v0.1.0",
    colSpan: "lg:col-span-1",
  },
];

const supportingRepos = [
  {
    name: "expo-libsignal-dezire",
    description:
      "Expo React Native native module wrapper for libsignal-dezire providing cryptographic primitives to iOS and Android.",
    tech: ["Swift", "React Native", "Expo", "E2EE"],
    url: "https://github.com/deez-in/expo-libsignal-dezire",
    version: "v0.1.0",
    colSpan: "lg:col-span-2",
  },
  {
    name: "expo-audio-opus",
    description:
      "Native Expo audio alternative to record & play .ogg files with bidirectional PCM to OPUS encoding and decoding.",
    tech: ["Rust", "Swift", "Kotlin", "Audio"],
    url: "https://github.com/deez-in/expo-audio-opus",
    version: "v0.1.0",
    colSpan: "lg:col-span-2",
  },
  {
    name: "expo-native-mqtt",
    description:
      "High-performance native MQTT client bindings for Expo applications wrapping HiveMQ (Android) and CocoaMQTT (iOS).",
    tech: ["Kotlin", "Swift", "Expo", "MQTT"],
    url: "https://github.com/deez-in/expo-native-mqtt",
    version: "v0.1.0",
    colSpan: "lg:col-span-2 md:col-span-2",
  },
  {
    name: "expo-google-native-oauth",
    description:
      "Native Google OAuth module for Expo React Native utilizing GIDSignIn on iOS and Credential Manager on Android.",
    tech: ["TypeScript", "OAuth", "Android", "iOS"],
    url: "https://github.com/deez-in/expo-google-native-oauth",
    version: "v0.1.0",
    colSpan: "lg:col-span-1",
  },
  {
    name: "deez-site",
    description:
      "The official web portal and showcase landing page for the deez.in organization and DeezChatz ecosystem.",
    tech: ["Astro", "Tailwind CSS", "TypeScript", "Web"],
    url: "https://github.com/deez-in/deez-site",
    version: "v0.1.0",
    colSpan: "lg:col-span-1",
  },
];
---

<section
  id="ecosystem"
  class="max-w-[1440px] mx-auto px-4 md:px-8 py-16 md:py-24 border-t border-border"
>
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
    <div>
      <span class="text-xs font-mono text-accent/80 tracking-widest block mb-2 font-semibold">
        01 // ECOSYSTEM
      </span>
      <h2 class="text-3xl font-mono font-bold tracking-tight">Deez Ecosystem</h2>
      <p class="text-text/70 mt-2 text-sm max-w-xl">
        A privacy-first, end-to-end encrypted messaging ecosystem built across systems-level Rust backends, cryptographic protocol implementations, and high-performance native Expo mobile modules. Click any card for repository release information and live commits.
      </p>
    </div>
    <a
      href="https://github.com/deez-in"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-xs font-mono border border-border px-3.5 py-2 hover:border-text hover:text-text transition-colors self-start md:self-auto group bg-card/50"
    >
      <span>github.com/deez-in</span>
      <svg
        class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform text-accent group-hover:text-text"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
        ></path>
      </svg>
    </a>
  </div>

  <div class="mb-16">
    <div class="mb-6">
      <h3 class="text-lg font-mono font-semibold text-text">Core Infrastructure & Services</h3>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        coreRepos.map((repo) => (
          <a
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`repo-modal-trigger border border-border/80 p-6 bg-card hover:bg-white dark:hover:bg-[#18181b] hover:border-text/70 dark:hover:border-white/40 hover:-translate-y-1 hover:shadow-md transition-all duration-300 group flex flex-col justify-between block cursor-pointer ${repo.colSpan || ""}`}
            data-repo-name={repo.name}
            data-repo-url={repo.url}
            data-repo-desc={repo.description}
            data-repo-tech={JSON.stringify(repo.tech)}
            data-repo-version={repo.version}
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <h4 class="font-mono font-bold text-base text-text group-hover:text-text transition-colors truncate">
                  {repo.name}
                </h4>
                <svg
                  class="w-4 h-4 text-text/40 group-hover:text-text rotate-45 group-hover:scale-110 transition-all flex-shrink-0 ml-2 -mt-3"
                  viewBox="0 -960 960 960"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path d="M480-80 240-320l57-57 183 183 183-183 57 57L480-80ZM298-584l-58-56 240-240 240 240-58 56-182-182-182 182Z"></path>
                </svg>
              </div>
              <p class="text-sm text-text/70 group-hover:text-text/90 transition-colors mb-4 min-h-[4.25rem] leading-relaxed line-clamp-3">
                {repo.description}
              </p>
            </div>
            <div class="flex flex-wrap gap-1.5 pt-3 border-t border-border/60">
              {repo.tech.map((t) => (
                <span class="text-xs font-mono text-text/60 group-hover:text-text/80 bg-text/5 group-hover:bg-text/10 px-2 py-0.5 transition-colors">
                  {t}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <div>
    <div class="mb-6">
      <h3 class="text-lg font-mono font-semibold text-text">
        Supporting Native Libraries & Modules
      </h3>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        supportingRepos.map((repo) => (
          <a
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`repo-modal-trigger border border-border/80 p-6 bg-card hover:bg-white dark:hover:bg-[#18181b] hover:border-text/70 dark:hover:border-white/40 hover:-translate-y-1 hover:shadow-md transition-all duration-300 group flex flex-col justify-between block cursor-pointer ${repo.colSpan || ""}`}
            data-repo-name={repo.name}
            data-repo-url={repo.url}
            data-repo-desc={repo.description}
            data-repo-tech={JSON.stringify(repo.tech)}
            data-repo-version={repo.version}
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <h4 class="font-mono font-bold text-base text-text group-hover:text-text transition-colors truncate">
                  {repo.name}
                </h4>
                <svg
                  class="w-4 h-4 text-text/40 group-hover:text-text rotate-45 group-hover:scale-110 transition-all flex-shrink-0 ml-2"
                  viewBox="0 -960 960 960"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path d="M480-80 240-320l57-57 183 183 183-183 57 57L480-80ZM298-584l-58-56 240-240 240 240-58 56-182-182-182 182Z"></path>
                </svg>
              </div>
              <p class="text-sm text-text/70 group-hover:text-text/90 transition-colors mb-4 min-h-[4.25rem] leading-relaxed line-clamp-3">
                {repo.description}
              </p>
            </div>
            <div class="flex flex-wrap gap-1.5 pt-3 border-t border-border/60">
              {repo.tech.map((t) => (
                <span class="text-xs font-mono text-text/60 group-hover:text-text/80 bg-text/5 group-hover:bg-text/10 px-2 py-0.5 transition-colors">
                  {t}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupRepoTriggers() {
    const cards = document.querySelectorAll(".repo-modal-trigger");
    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        const mouseEvent = e as MouseEvent;
        // Allow ctrl/cmd/middle-click to open direct GitHub link in new tab
        if (
          mouseEvent.ctrlKey ||
          mouseEvent.metaKey ||
          mouseEvent.shiftKey ||
          mouseEvent.button !== 0
        ) {
          return;
        }

        e.preventDefault();
        const el = card as HTMLElement;
        const name = el.dataset.repoName || "";
        const url = el.dataset.repoUrl || el.getAttribute("href") || "";
        const description = el.dataset.repoDesc || "";
        const version = el.dataset.repoVersion || "v0.1.0-dev";
        const tech = el.dataset.repoTech ? JSON.parse(el.dataset.repoTech) : [];

        if (typeof (window as any).openRepoModal === "function") {
          (window as any).openRepoModal({
            name,
            url,
            description,
            tech,
            defaultVersion: version,
          });
        }
      });
    });
  }

  setupRepoTriggers();
  document.addEventListener("astro:page-load", setupRepoTriggers);
</script>
