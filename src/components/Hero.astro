---
import KnowledgeGraph from "./KnowledgeGraph.astro";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-16 overflow-hidden"
>
  <KnowledgeGraph />

  <div
    class="max-w-[1440px] mx-4 sm:mx-8 md:mx-auto px-4 md:px-8 w-full z-10 pointer-events-none"
  >
    <div class="max-w-xl text-center md:text-left pointer-events-none">
      <div class="mb-8 select-none">
        <img
          src="/signature.png"
          alt="Signature"
          class="h-36 md:h-52 rotate-[5deg] w-auto dark:invert opacity-90 hover:opacity-100 transition-all duration-500 hover:scale-105 cursor-default mx-auto -my-16 md:mx-0"
        />
      </div>


      <h1
        class="text-4xl sm:text-5xl md:text-7xl font-mono font-bold tracking-tighter mb-3"
      >
        Debarka Mondal
      </h1>
      <h2 class="text-xl md:text-2xl text-accent font-mono mb-4">
        Full Stack & Systems Engineer
      </h2>

      <div class="pointer-events-auto text-xs md:text-sm font-mono text-text/75 mb-8 flex items-center justify-center md:justify-start">
        <span>
          Creator of github org{" "}
          <a
            href="https://github.com/deez-in"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text font-semibold underline underline-offset-4 decoration-text/60 hover:decoration-text hover:text-accent transition-colors"
          >
            Deez-in
          </a>
        </span>
      </div>

      <div class="border-l-2 border-accent/40 pl-4 py-1 mb-10 text-left">
        <p class="text-base md:text-lg text-text/80 italic font-serif">
          "Learning is a journey, certainty slows you down, Doubt keeps you moving."
        </p>
      </div>
      <div class="pointer-events-auto flex flex-col items-center md:items-start gap-4">
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
          <a
            href="https://chatz.deez.in"
            target="_blank"
            rel="noopener noreferrer"
            class="border border-text bg-text text-bg hover:bg-transparent hover:text-text px-7 py-3 font-mono text-xs uppercase tracking-wider transition-all duration-300 relative overflow-hidden group cursor-pointer inline-flex items-center gap-2"
          >
            <span>DeezChatz</span>
            <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
          </a>

          <a
            href="https://github.com/deez-in"
            target="_blank"
            rel="noopener noreferrer"
            class="border border-text px-7 py-3 font-mono text-xs uppercase tracking-wider hover:bg-text hover:text-bg transition-all duration-300 relative overflow-hidden group cursor-pointer inline-flex items-center gap-2"
          >
            <span>Github Org</span>
            <span class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">↗</span>
          </a>
        </div>

        <div>
          <button
            id="explore-btn"
            class="border border-border hover:border-text bg-card hover:bg-white dark:hover:bg-[#18181b] px-7 py-3 font-mono text-xs uppercase tracking-wider transition-all duration-300 relative overflow-hidden group cursor-pointer inline-flex items-center gap-2 text-text"
          >
            <span>Explore Knowledge Graph</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const exploreBtn = document.getElementById("explore-btn");

  exploreBtn?.addEventListener("click", () => {
    // Call the global function defined in KnowledgeGraph.astro
    if (window.toggleGraphInteractivity) {
      window.toggleGraphInteractivity();
    }
  });
</script>
